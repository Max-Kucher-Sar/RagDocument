# Необязательные настройки Docker Compose. Без .env запуск использует эти значения.
# Адреса Ollama и Qdrant, а также путь хранения задаёт docker-compose.yaml.
APP_PORT=8000
APP_TOKEN=

CHAT_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200

QDRANT_COLLECTION=documents_ollama_qwen3
MAX_UPLOAD_MB=20
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=6
SCORE_THRESHOLD=0.25
